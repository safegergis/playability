# Playability Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=playability_user
DB_PASSWORD=your_secure_password_here
DB_NAME=playability
DB_SSLMODE=disable

# ============================================
# Backend Configuration
# ============================================
PORT=8080
ENVIRONMENT=development

# JWT Configuration (IMPORTANT: Use a secure random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ============================================
# Frontend Configuration
# ============================================
# Use http://backend:8080 for Docker, http://localhost:8080 for local development
NUXT_PUBLIC_API_URL=http://backend:8080

# ============================================
# External API Keys
# ============================================
IGDB_ACCESS_TOKEN=your_igdb_access_token_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here
CLAUDE_API_KEY=your_claude_api_key_here

# ============================================
# PostgreSQL (for Docker)
# ============================================
POSTGRES_DB=playability
POSTGRES_USER=playability_user
POSTGRES_PASSWORD=your_secure_password_here
